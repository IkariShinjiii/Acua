# Copy this file to .env.local and fill in your Supabase project's values.
# Find both under: Supabase Dashboard > Project Settings > API.
# The anon key is safe to expose client-side — it's scoped by Row Level
# Security policies, not by secrecy. Never put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
